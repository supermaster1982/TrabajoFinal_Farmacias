# --- Requeridas ---
OPENAI_API_KEY=tu_key_de_openai_aqui
QDRANT_URL=tu_url_de_qdrant_cloud_aqui
QDRANT_API_KEY=tu_key_de_qdrant_aqui

# --- LangSmith (observabilidad activa del proyecto) ---
LANGSMITH_API_KEY=tu_key_de_langsmith_aqui
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=asistente-farmacias

# --- Langfuse (implementado en el código, opcional — hoy no configurado) ---
# Descomenta y completa si quieres activarlo también.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Modelo principal (opcional, tiene default razonable) ---
# GEN_MODEL=gpt-5.4-mini

# --- Re-rank del RAG (opcional): desactivado por defecto — ver justificación
# en rag_subgrafo.py. Poner en "true" solo si el corpus crece o se vuelve
# más ambiguo. ---
RERANK_ACTIVADO=false

# --- CORS y rate limiting del endpoint /chat ---
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60

# Genera la tuya con: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=