# --- Requeridas ---
OPENAI_API_KEY=tu_key_de_openai_aqui
QDRANT_URL=tu_url_de_qdrant_cloud_aqui
QDRANT_API_KEY=tu_key_de_qdrant_aqui

# --- Base de datos (historial de conversación persistente) ---
# Antes el historial vivía en RAM (MemorySaver) y se perdía si el servidor
# se reiniciaba — la rúbrica exige que el historial multi-turno esté
# "persistido" por user_id, no solo vivo durante la sesión. PostgresSaver
# (ver graph.py) usa esta base para guardarlo de verdad.
# En Render: crea una base "PostgreSQL" nueva (plan Free alcanza) y copia
# su "External Database URL" (o "Internal Database URL" si el backend
# corre en el mismo proyecto/red de Render que la base).
DATABASE_URL=postgresql://usuario:password@host/nombre_db

# --- LangSmith (observabilidad activa del proyecto) ---
LANGSMITH_API_KEY=tu_key_de_langsmith_aqui
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=asistente-farmacias

# --- Langfuse (implementado en el código, opcional — hoy no configurado) ---
# Descomenta y completa si quieres activarlo también.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Modelo del agente — obligatoria, sin valor por defecto (ver graph.py)
GEN_MODEL=gpt-5.6-luna

#Modelo de guardas
GUARD_MODEL=gpt-5.6-luna

# --- Re-rank del RAG (opcional): desactivado por defecto — ver justificación
# en rag_subgrafo.py. Poner en "true" solo si el corpus crece o se vuelve
# más ambiguo. ---
RERANK_ACTIVADO=false

# --- CORS y rate limiting del endpoint /chat ---
# En local, el front corre en :5500 (python3 -m http.server). En producción,
# agrega la URL real donde quedó desplegado el front — sin esto, el backend
# rechaza las peticiones del front por CORS aunque el servidor esté sano.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://trabajofinal-farmacias-frontend.onrender.com
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60

# Genera la tuya con: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=


# URL del servidor MCP del vademécum chileno. En local, no hace falta
# tocarla (usa localhost:8803 por defecto) — solo hay que correr
# `poetry run python servidor_vademecum_chile.py` en otra terminal antes
# de levantar la API. En producción, reemplazar por la URL pública real
# del servicio MCP desplegado (pendiente coordinar con el equipo).
MCP_VADEMECUM_CHILE_URL=http://localhost:8803/mcp
